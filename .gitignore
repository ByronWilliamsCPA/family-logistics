# =============================================================================
# .gitignore for family-logistics (PUBLIC repository)
# =============================================================================
# Two deliberate styles, and tests/unit/test_gitignore_guards.py enforces the
# second one with real git:
#
# 1. Build, packaging and generic output directories (/build/, /dist/, /lib/,
#    /var/, /logs/, /tmp/, ...) are anchored to the repository root with a
#    leading "/", so a future source package of the same name below src/ is
#    never silently ignored. Tool caches and editor directories (__pycache__/,
#    .pytest_cache/, .vscode/, ...) stay unanchored because they appear in any
#    subdirectory and never hold source.
# 2. Everything that protects household data or credentials (registry seeds,
#    backups, reports, assessments, transcripts, databases, calendar exports,
#    .aws/, .ssh/, .gcloud/) is unanchored on purpose: it must match at any
#    depth, because the file that leaks is usually not at the repository root.
#    If a source package ever needs one of those names, add an explicit
#    negation for that package path rather than anchoring the guard.

# -----------------------------------------------------------------------------
# Python bytecode, builds and packaging
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/dist/
/develop-eggs/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/pip-wheel-metadata/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
/__pypackages__/

# -----------------------------------------------------------------------------
# Tests, coverage and tool caches
# -----------------------------------------------------------------------------
/htmlcov/
/.tox/
/.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
/pytest-html-report/
/test-results/
.mutmut-cache
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/
/.scannerwork/
/.sonar/
.pre-commit-framework-cache

# -----------------------------------------------------------------------------
# Environments and local configuration
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.venv
/env/
/venv/
/ENV/
/env.bak/
/venv.bak/
.python-version
Pipfile.lock
local.ini
local.conf
local_settings.py
docker-compose.override.yml

# -----------------------------------------------------------------------------
# Credentials and secrets (never commit)
# -----------------------------------------------------------------------------
*.pem
*.key
*.cert
credentials.json
secrets.json
**/service-account*.json
**/gcp-credentials*.json
**/*-key.json
.gcloud/
/.config/gcloud/
.aws/
.ssh/

# -----------------------------------------------------------------------------
# Editors, IDEs and OS files
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace
.spyderproject
.spyproject
.ropeproject
.project
.pydevproject
.settings/
.clj-kondo/
.lsp/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# -----------------------------------------------------------------------------
# Docs, notebooks, misc tooling
# -----------------------------------------------------------------------------
/site
/docs/_build/
.ipynb_checkpoints/
*.ipynb
/profile_default/
ipython_config.py
celerybeat-schedule
celerybeat.pid
*.sage.py
*.mo
*.pot
/instance/
.webassets-cache
.scrapy
/target/
/node_modules/
/.cache/huggingface/
/huggingface_cache/
/.modal/

# Git worktrees live inside the project (see CLAUDE.md)
/.worktrees/

# Temporary and reference files
/tmp/
/temp/
*.tmp
*.bak
/tmp_cleanup/.tmp-*
!/tmp_cleanup/.gitkeep

# Logs
/logs/
*.log

# SBOM output (generated in CI)
sbom-*.json
sbom-*.xml
*.cdx.json
*.spdx.json
reuse-spdx.json

# Generic data and model outputs (template defaults)
/models/
/weights/
/results/
/output/
/notebooks/.ipynb_checkpoints/

# Template feedback buffer: kept untracked here, so entries are shared with the
# template team out of band (see CLAUDE.md)
/docs/template_feedback.md

# =============================================================================
# Family Logistics: real household data stays local (this repository is public)
# =============================================================================
# Runtime database and WAL/SHM side files. The *.db and *.sqlite globs match at
# any depth; /data/ is root-anchored on purpose (the tracked data/.gitkeep
# placeholder lives there and a package data directory below src/ must stay
# trackable). Backups match at any depth.
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
db.sqlite3-journal
backups/

# Registry seed data and site configuration (people, locations, addresses,
# calendar IDs, school assignments). Commit only *.example.* templates. The
# globs and their example exceptions have no slash, so both apply at any depth.
# config/local/ contains a slash, so git already roots it at the repository
# root; the leading slash only makes that explicit.
/config/local/
registry*.yaml
registry*.yml
registry*.json
!registry*.example.yaml
!registry*.example.yml
!registry*.example.json
site*.env
stack.env

# Calendar exports pulled from real calendars (any depth). Synthetic fixtures
# under tests/fixtures/synthetic/ are the only .ics files that may be tracked.
*.ics
!/tests/fixtures/synthetic/**/*.ics
/fixtures/real/
/tests/fixtures/real/

# M0 discovery output (filled results, inventories, probe logs)
/tools/m0/results/
/tools/m0/*-results.md
/tools/m0/RESULTS.md

# Pseudonym mappings and the private-terms deny-list (any depth; ignore rules do
# not untrack a file that was already added, so also keep them out of the tree)
pseudonyms*.yaml
pseudonyms*.json
private-terms*.txt
denylist*.txt

# Reports, assessments and LLM transcripts generated from real schedules
reports/
assessments/
llm-transcripts/
