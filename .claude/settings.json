{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run basedpyright:*)",
      "Bash(uv run bandit:*)",
      "Bash(uv run pip-audit:*)",
      "Bash(uv run pre-commit run:*)",
      "Bash(uv run mkdocs build:*)",
      "Bash(uv run family-logistics:*)",
      "Bash(uv sync:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.config/family-logistics/**)",
      "Read(./data/**)",
      "Read(./backups/**)",
      "Read(./config/local/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(rm:*)"
    ]
  }
}
