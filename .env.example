# Family Logistics environment (FL_ prefix). Copy to .env for a native run
# (`uv run family-logistics ...`), where the app reads ./.env itself; variables
# already in the process environment win over it, and a blank value (FL_X=)
# counts as unset.
# Docker Compose also reads .env, but only to fill four values in
# docker-compose.yml: FL_HA_TOKEN, FL_TIMEZONE, FL_JSON_LOGS and
# FL_ROUTE_PROVIDER. Every other setting here does not reach the dev container
# unless it is added under environment: in that file.
# Never commit real values. Production secrets come from the deployment's
# secret store through the environment; site configuration lives in the private
# deployment repository.

# --- Runtime -------------------------------------------------------------------
FL_LOG_LEVEL=INFO
# JSON logs (the container image defaults to true); false gives readable console logs.
FL_JSON_LOGS=false
FL_INCLUDE_TIMESTAMP=true
FL_TIMEZONE=America/Los_Angeles
FL_DATABASE_PATH=/data/family_logistics.db
# Private registry seed (people, places, calendars). Keep it OUTSIDE the repo;
# start from config/registry.example.yaml.
FL_REGISTRY_SEED=
# Native runs listen on loopback; the container image sets 0.0.0.0 itself.
FL_BIND_HOST=127.0.0.1
FL_PORT=8080

# --- Home Assistant (HA calls the app; the app never holds an HA token) -------
# Bearer token HA presents on the HA-only routes. >= 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FL_HA_TOKEN=
# Schools whose schedules HA pushes to POST /api/v1/ingest/ha-snapshot: a JSON
# list mapping calendar entity IDs to a registry location and the people who
# attend it. Only these calendars are accepted. Keep real entity IDs in the
# private deployment repository. Shape (see docs/guides/ha-school-snapshot.md):
#   [{"location_id": "middle-school", "person_ids": ["sam"],
#     "bell_calendars": ["calendar.example_bell"],
#     "district_calendars": ["calendar.example_district"]}]
FL_HA_SCHOOLS=

# --- iCloud CalDAV (dedicated Apple ID with View-Only shares) -----------------
FL_CALDAV_URL=https://caldav.icloud.com
# Registrable domains the collector may reach, for the first request and every
# redirect hop (subdomains match). Comma-separated; no scheme, path, port or *.
FL_CALDAV_ALLOWED_HOSTS=icloud.com
FL_CALDAV_USERNAME=
FL_CALDAV_APP_PASSWORD=
# Calendars to collect, by display name or calendar ID (comma-separated).
# Calendars not listed are never read. Do not commit real names or IDs.
FL_CALDAV_CALENDARS=
FL_CALDAV_TRANSPORT_CALENDAR=Family Transportation
# Collection window in local days around today, and the staleness limit.
FL_COLLECT_DAYS_BACK=2
FL_COLLECT_DAYS_AHEAD=14
FL_SOURCE_MAX_STALENESS_MINUTES=120

# --- Registry UI (M4; behind Traefik + Authentik) ------------------------------
# Only these TCP peers may assert identity headers (your reverse proxy's
# address). Empty, the default, trusts no proxy.
FL_PROXY_TRUSTED_CIDRS=
# Authentik usernames allowed into the UI; empty denies everyone.
FL_UI_ALLOWED_USERS=

# --- Data protection ----------------------------------------------------------
# Fernet key for protected addresses at rest. Required before any protected
# address is stored. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FL_DATA_KEY=
# HMAC-SHA256 key for the audit-log hashes: 32 random bytes as url-safe base64
# (44 characters). Required in production mode; must differ from FL_DATA_KEY.
# Generate:
#   python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FL_AUDIT_KEY=
# Version stored with each audit row; raise it only when rotating FL_AUDIT_KEY.
FL_AUDIT_KEY_VERSION=1

# --- Notifications (routing to people lives in Apprise config) ----------------
# Apprise API base URL (http or https, no user:password in the URL). Required
# when FL_NOTIFICATION_MODE=production; serve refuses to start without it.
FL_APPRISE_URL=
# Key of the saved Apprise configuration the app posts to (POST /notify/{key}).
FL_APPRISE_CONFIG_KEY=family-logistics
# Dedicated tags, sent as the "tag" field. Each must be fl-<word>[-<word>] in
# lower case and all six must differ; other values are rejected at startup.
FL_APPRISE_TAG_REPORT=fl-report
FL_APPRISE_TAG_STATUS=fl-status
FL_APPRISE_TAG_WARNING=fl-warning
FL_APPRISE_TAG_URGENT=fl-urgent
FL_APPRISE_TAG_OPS=fl-ops
FL_APPRISE_TAG_SHADOW=fl-shadow
# shadow (default): Sunday report to the admin parent only. Moving to production is a
# joint decision of both parents made outside the app; the app does not enforce it.
FL_NOTIFICATION_MODE=shadow
FL_QUIET_HOURS_START=22:00
FL_QUIET_HOURS_END=06:00
FL_IMMINENT_WINDOW_MINUTES=180

# Engine thresholds (proposed defaults pending owner approval)
FL_SAME_LOCATION_GAP_MINUTES=60
FL_OVERNIGHT_GAP_HOURS=14
FL_TRAVEL_BUFFER_MINUTES=10
FL_STOP_BUFFER_MINUTES=5

# --- Routing -----------------------------------------------------------------------
# ha_relay | google_routes | static
FL_ROUTE_PROVIDER=ha_relay
FL_GOOGLE_ROUTES_API_KEY=
FL_ROUTES_MONTHLY_BUDGET_USD=10
FL_ROUTES_BUDGET_WARN_USD=8

# --- Narrative LLM (M5; blocked until the inference-VM route is live) ----------
FL_LLM_ENABLED=false
FL_LLM_BASE_URL=
FL_LLM_API_KEY=
FL_LLM_MODEL=

# --- Schedules (local time) ----------------------------------------------------
FL_WEEKLY_CRON=0 15 * * SUN
FL_DAILY_CRON=0 19 * * *
FL_CHANGE_SCAN_MINUTES=60
FL_SCHEDULER_ENABLED=false
